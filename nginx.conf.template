worker_processes 2;

pid ${HOME}/ingenium/${SHORT_HOSTNAME}/nginx.pid;

error_log  ${HOME}/ingenium/${SHORT_HOSTNAME}/logs/nginx_error.log error;

events {
    worker_connections 1024;
}

http {
    sendfile off;

    client_body_temp_path ${HOME}/ingenium/${SHORT_HOSTNAME}/nginx_temp/client_body_temp;
    fastcgi_temp_path ${HOME}/ingenium/${SHORT_HOSTNAME}/nginx_temp/fastcgi_temp;
    proxy_temp_path ${HOME}/ingenium/${SHORT_HOSTNAME}/nginx_temp/proxy_temp;
    scgi_temp_path ${HOME}/ingenium/${SHORT_HOSTNAME}/nginx_temp/scgi_temp;
    uwsgi_temp_path ${HOME}/ingenium/${SHORT_HOSTNAME}/nginx_temp/uwsgi_temp;

    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format main '[INFO]: [$time_iso8601'
                    'Z'
                    '] $remote_addr - $remote_user  '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent"';

    proxy_connect_timeout       300;
    proxy_send_timeout          300;
    proxy_read_timeout          300;
    proxy_buffering             off;
    send_timeout                300;
    keepalive_timeout           0;

    server {
        listen 9443 ssl;
        server_name ${HOSTNAME};
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        error_log  ${HOME}/ingenium/${SHORT_HOSTNAME}/logs/nginx_error_9443.log error;
        access_log ${HOME}/ingenium/${SHORT_HOSTNAME}/logs/nginx_access_9443.log main;
        
        ssl_certificate         ${ING_VENUE_DIR}/config/.secret/.server.crt;
        ssl_certificate_key     ${ING_VENUE_DIR}/config/.secret/.server.key;
        ssl_protocols           TLSv1.2 TLSv1.3;
        ssl_ciphers             ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-SHA384:ECDHE-RSA-AES256-SHA384:ECDHE-ECDSA-AES128-SHA256:ECDHE-RSA-AES128-SHA256;

        # Proxying connections to application servers
        # proxy query server
        location ~ ^/api/v3/ {
            proxy_http_version 1.1;
            proxy_set_header   Connection "";
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Host $server_name;

            proxy_pass          http://127.0.0.1:19443;
        }

        location / {
            return 404;
        }
    }

    server {
        listen 9444 ssl;
        server_name ${HOSTNAME};
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        error_log  ${HOME}/ingenium/${SHORT_HOSTNAME}/logs/nginx_error_9444.log error;
        access_log ${HOME}/ingenium/${SHORT_HOSTNAME}/logs/nginx_access_9444.log main;
        
        ssl_certificate         ${ING_VENUE_DIR}/config/.secret/.server.crt;
        ssl_certificate_key     ${ING_VENUE_DIR}/config/.secret/.server.key;
        ssl_protocols           TLSv1.2 TLSv1.3;
        ssl_ciphers             ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-SHA384:ECDHE-RSA-AES256-SHA384:ECDHE-ECDSA-AES128-SHA256:ECDHE-RSA-AES128-SHA256;

        # Proxying connections to application servers
        # proxy query server
        location ~ ^/api/v3/ {
            proxy_http_version 1.1;
            proxy_set_header   Connection "";
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Host $server_name;

            proxy_pass          http://127.0.0.1:19444;
        }

        location / {
            return 404;
        }
    }

    server {
        listen 9445 ssl;
        server_name ${HOSTNAME};
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        error_log  ${HOME}/ingenium/${SHORT_HOSTNAME}/logs/nginx_error_9445.log error;
        access_log ${HOME}/ingenium/${SHORT_HOSTNAME}/logs/nginx_access_9445.log main;
        
        ssl_certificate         ${ING_VENUE_DIR}/config/.secret/.server.crt;
        ssl_certificate_key     ${ING_VENUE_DIR}/config/.secret/.server.key;
        ssl_protocols           TLSv1.2 TLSv1.3;
        ssl_ciphers             ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-SHA384:ECDHE-RSA-AES256-SHA384:ECDHE-ECDSA-AES128-SHA256:ECDHE-RSA-AES128-SHA256;

        # Proxying connections to application servers
        # proxy query server
        location ~ ^/api/v3/ {
            proxy_http_version 1.1;
            proxy_set_header   Connection "";
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Host $server_name;

            proxy_pass          http://127.0.0.1:19445;
        }

        location / {
            return 404;
        }
    }
}
